[Desktop Entry]
Name=DeGram Desktop
Comment=Desktop version of DeGram - Privacy-first Telegram client
TryExec=degram
Exec=env DESKTOPINTEGRATION=1 degram -- %U
Icon=com.degram.desktop
Terminal=false
StartupWMClass=DeGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;degram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=degram -quit
Name=Quit DeGram
Icon=application-exit
